import "./styles/theme.easys"
import Header from "./components/Header.easys"
import Footer from "./components/Footer.easys"
import FeatureCard from "./components/FeatureCard.easys"
import ProjectCard from "./components/ProjectCard.easys"

app EasySDemo {

  page Home "/" {

    state {
      count: number = 0
      loggedIn: boolean = true
      features: string[] = ["Components", "State", "Routing", "Control flow", "Imports"]
    }

    ui {
      Header()

      section {
        container class HeroStyle {
          heading "EasyS Programming Language"
          text "A simple declarative language that compiles into HTML, CSS and JavaScript"

          text count

          button "Increase counter" {
            action {
              count += 1
            }
          }
        }
      }

      section {
        heading "Features"

        FeatureCard(
          "Components",
          "Reusable UI blocks across files"
        )

        FeatureCard(
          "State",
          "Reactive variables with actions"
        )

        FeatureCard(
          "Routing",
          "SPA navigation via History API"
        )

        FeatureCard(
          "Imports",
          "Multi-file projects with easys.config"
        )
      }

      section {
        heading "Status"

        if loggedIn {
          heading "Welcome back!"
          text "You are exploring the official EasyS demo"
        } else {
          heading "Please login"
          text "Demo mode is limited"
        }
      }

      section {
        heading "Feature list"

        for feature in features {
          text feature
        }
      }

      Footer()
    }
  }

  page About "/about" {

    ui {
      Header()

      section {
        container class SectionStyle {
          heading "About EasyS"
          text "EasyS is a custom programming language for creating websites."
          text "No React. No frameworks. Only EasyS to HTML CSS JS."
          text "Pipeline: Lexer → Parser → AST → Semantic → Components → Codegen"
        }
      }

      section {
        heading "Goals"
        text "Build real small sites: portfolio, landing, todo, catalogs"
        link "Back to Home" "/"
      }

      Footer()
    }
  }

  page Projects "/projects" {

    state {
      projects: string[] = ["Compiler", "Runtime", "CLI", "Router", "Module loader"]
    }

    ui {
      Header()

      section {
        heading "Projects"

        ProjectCard(
          "Compiler",
          "EasyS compiler written in TypeScript"
        )

        ProjectCard(
          "Runtime",
          "Custom browser runtime with reactive updates"
        )

        ProjectCard(
          "CLI",
          "easys init build dev check format"
        )

        ProjectCard(
          "Module system",
          "import components and styles from other .easys files"
        )
      }

      section {
        heading "Project names"

        for project in projects {
          text project
        }
      }

      section {
        button "Go Home" {
          action {
            navigate "/"
          }
        }
      }

      Footer()
    }
  }

  page Contact "/contact" {

    state {
      sent: boolean = false
    }

    ui {
      Header()

      section {
        container class SectionStyle {
          heading "Contact"
          text "Demo contact page. Full forms arrive with input bind in a later version."

          button "Mark as sent" {
            action {
              sent = true
            }
          }

          if sent {
            text "Message sent!"
          } else {
            text "Waiting for your message..."
          }
        }
      }

      section {
        link "Home" "/"
        link "About" "/about"
        link "Projects" "/projects"
      }

      Footer()
    }
  }
}
