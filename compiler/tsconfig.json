{
  "compilerOptions": {
    "target": "ES2020",

    "module": "ESNext",

    "moduleResolution": "Bundler",

    "allowImportingTsExtensions": true,

    "noEmit": true,

    "lib": ["ES2021"],

    "strict": true,

    "skipLibCheck": true,

    "types": ["vitest/globals"]
  },

  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
